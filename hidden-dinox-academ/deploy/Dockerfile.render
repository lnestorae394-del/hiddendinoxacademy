# Образ сервера Academy + FFmpeg для Video Studio (необязательный вариант для Render; см. docs/VIDEO_STUDIO.md).
# Сборка из КОРНЯ проекта:  docker build -f deploy/Dockerfile.render -t hd-academy .
# В Render: Settings → Environment: Docker, Dockerfile Path: deploy/Dockerfile.render, Docker Build Context Directory: .
FROM node:22-bookworm-slim
# ffmpeg из Debian собран с libass (субтитры) и loudnorm (громкость); шрифты нужны для текста на видео
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fontconfig fonts-liberation fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
ENV NODE_ENV=production
CMD ["node", "server.js"]
