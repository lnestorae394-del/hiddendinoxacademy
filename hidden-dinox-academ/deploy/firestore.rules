rules_version = '2';
// Hidden Dinox Video Studio — проект hidden-dinox-video-staging.
// Браузер НЕ обращается к Firestore напрямую: все данные читает и пишет только сервер (Firebase Admin SDK, он правила обходит
// и сам проверяет токен и роль). Поэтому для клиентов закрыто всё — включая коллекцию users (роли назначает только сервер).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
