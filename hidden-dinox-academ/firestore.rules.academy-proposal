// HIDDEN DINOX ACADEMY — ПРЕДЛОЖЕНИЕ правил Firestore (не применено и не проверено на эмуляторе).
//
// Сервер работает через Admin SDK, который правила НЕ проверяют. Клиент академии с Firestore
// напрямую не работает: всё идёт через /api. Поэтому для коллекций академии клиенту нужен полный запрет.
//
// ВАЖНО перед применением:
// 1) Правила Firestore складываются по «ИЛИ»: если в текущих правилах есть широкое разрешение
//    (например, match /{document=**} { allow read, write: if true; }), блоки ниже ничего не запретят.
//    Такое правило нужно убрать или сузить.
// 2) Старые страницы AI BOOST могли читать или писать referrals/users прямо из браузера.
//    Запрет может их сломать — сначала нужно увидеть текущие правила и старые страницы.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Коллекции академии: только сервер ---
    match /users/{uid}               { allow read, write: if false; }
    match /clicks/{clickId}          { allow read, write: if false; }
    match /trader_bindings/{traderId} { allow read, write: if false; }
    match /postback_events/{eventId} { allow read, write: if false; }
    match /deposit_events/{eventId}  { allow read, write: if false; }

    // --- Старая коллекция партнёрских данных: только сервер ---
    // (если старые страницы читают её из браузера — согласовать отдельно)
    match /referrals/{traderId}      { allow read, write: if false; }

    // Обучение, админ-панель, медиа, афиши, журнал, Telegram — только сервер (Admin SDK).
    // Ученики получают опубликованное через /api/learn с проверкой доступа; черновики и ответы тестов в браузер не попадают.
    match /courses/{id}            { allow read, write: if false; }
    match /course_modules/{id}     { allow read, write: if false; }
    match /course_lessons/{id}     { allow read, write: if false; }
    match /published_courses/{id}  { allow read, write: if false; }
    match /published_lessons/{id}  { allow read, write: if false; }
    match /lesson_progress/{id}    { allow read, write: if false; }
    match /media/{id}              { allow read, write: if false; }
    match /announcements/{id}      { allow read, write: if false; }
    match /audit_logs/{id}         { allow read, write: if false; }
    match /telegram_links/{id}     { allow read, write: if false; }

    // Читалка и партнёрская программа — только сервер. Финансовые данные клиент не читает и не пишет напрямую.
    match /reading_progress/{id}   { allow read, write: if false; }
    match /ref_codes/{id}          { allow read, write: if false; }
    match /referral_invites/{id}   { allow read, write: if false; }
    match /ledger/{id}             { allow read, write: if false; }
    match /partner_balances/{id}   { allow read, write: if false; }
    match /withdrawals/{id}        { allow read, write: if false; }
    match /partner_links/{id}      { allow read, write: if false; }

    // --- АУДИТ: остальные коллекции сервера (список собран по коду; тест tests/security-firestore-rules.test.js следит, чтобы новые не пропадали) ---
    // Бот, ИИ-ментор, ежедневные тесты, тренажёр графиков, база знаний, служебные и Video Studio: клиент напрямую не работает — только сервер (Admin SDK).
    match /academy_features/{id} { allow read, write: if false; }
    match /ai_budget/{id} { allow read, write: if false; }
    match /ai_budget_images/{id} { allow read, write: if false; }
    match /ai_budget_users/{id} { allow read, write: if false; }
    match /ai_settings/{id} { allow read, write: if false; }
    match /ai_usage/{id} { allow read, write: if false; }
    match /ai_usage_days/{id} { allow read, write: if false; }
    match /ai_user_usage/{id} { allow read, write: if false; }
    match /bot_admin_state/{id} { allow read, write: if false; }
    match /bot_broadcast_targets/{id} { allow read, write: if false; }
    match /bot_broadcasts/{id} { allow read, write: if false; }
    match /bot_config/{id} { allow read, write: if false; }
    match /bot_deliveries/{id} { allow read, write: if false; }
    match /bot_post_history/{id} { allow read, write: if false; }
    match /bot_posts/{id} { allow read, write: if false; }
    match /bot_users/{id} { allow read, write: if false; }
    match /chart_scenarios/{id} { allow read, write: if false; }
    match /chart_sessions/{id} { allow read, write: if false; }
    match /daily_attempts/{id} { allow read, write: if false; }
    match /daily_bank/{id} { allow read, write: if false; }
    match /daily_generator/{id} { allow read, write: if false; }
    match /daily_generator_runs/{id} { allow read, write: if false; }
    match /daily_keys/{id} { allow read, write: if false; }
    match /daily_runs/{id} { allow read, write: if false; }
    match /daily_sets/{id} { allow read, write: if false; }
    match /daily_settings/{id} { allow read, write: if false; }
    match /hd_knowledge/{id} { allow read, write: if false; }
    match /hd_knowledge_archive/{id} { allow read, write: if false; }
    match /hd_knowledge_backups/{id} { allow read, write: if false; }
    match /hd_knowledge_versions/{id} { allow read, write: if false; }
    match /mentor_messages/{id} { allow read, write: if false; }
    match /mentor_threads/{id} { allow read, write: if false; }
    match /pretrade_runs/{id} { allow read, write: if false; }
    match /system/{id} { allow read, write: if false; }
    match /videoStudioAccess/{id} { allow read, write: if false; }
    match /videoStudioClips/{id} { allow read, write: if false; }
    match /videoStudioEdits/{id} { allow read, write: if false; }
    match /videoStudioEvents/{id} { allow read, write: if false; }
    match /videoStudioJobs/{id} { allow read, write: if false; }
    match /videoStudioProjects/{id} { allow read, write: if false; }
    match /videoStudioSettings/{id} { allow read, write: if false; }
    match /videoStudioUsage/{id} { allow read, write: if false; }

    // --- Всё, что не описано выше, закрыто (клиенты академии с Firestore напрямую не работают: в public/ нет Firestore SDK). ---
    match /videoStudioEditors/{id}   { allow read, write: if false; }
    match /videoStudioClipEvents/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }

    // ВАЖНО: если в ТЕКУЩИХ правилах проекта есть широкое разрешение (например allow read, write: if true), его нужно УДАЛИТЬ: правила складываются по «ИЛИ» и запрет выше его не отменит.
    // --- Остальные существующие правила проекта — перенести сюда без изменений ---
  }
}
