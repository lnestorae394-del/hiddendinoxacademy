{
  "name": "hidden-dinox-video-studio",
  "version": "2.0.0",
  "description": "Hidden Dinox Video Studio — самостоятельный сайт нарезки трансляций в вертикальные клипы",
  "private": true,
  "main": "vs-server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node vs-server.js",
    "init-db": "node scripts/vs-init.js",
    "test": "sh tests/video-studio-run-all.sh --no-ui",
    "test:ui": "python3 tests/ui/test_video_studio_ui.py",
    "test:all": "sh tests/video-studio-run-all.sh",
    "audit:reads": "node tests/tools/video-studio-read-audit.js",
    "scan:secrets": "node tests/secret-scan.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "firebase-admin": "^13.7.0"
  }
}
